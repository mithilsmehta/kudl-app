# ---------------------------------------------------------------------------
# KUDL PETS — storefront environment variables
#
# Copy to `.env.local` for local development. On Vercel, set these under
# Project Settings → Environment Variables (never commit real values).
#
# Everything prefixed with NEXT_PUBLIC_ is inlined into the browser bundle and
# is therefore PUBLIC. Never put DATABASE_URL, JWT_SECRET, COOKIE_SECRET or any
# Medusa admin credential in this file.
# ---------------------------------------------------------------------------

# Public base URL of the Medusa Store API.
#   local:      http://localhost:9000
#   production: https://YOUR-MEDUSA-BACKEND-DOMAIN
# Required. No trailing slash.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa publishable API key (Medusa Admin → Settings → Publishable API Keys).
# Required — the build fails without it (see check-env-variables.js).
# Safe for the browser, but it is environment-specific: use the key that
# belongs to the backend NEXT_PUBLIC_MEDUSA_BACKEND_URL points at.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_YOUR_PUBLISHABLE_KEY

# Fallback country code (ISO 2, lowercase) when the visitor's region can't be
# detected. Must match a country in a Medusa region. KUDL Pets ships in India.
NEXT_PUBLIC_DEFAULT_REGION=in

# Canonical site URL, used for `metadataBase` (Open Graph / canonical links).
# Optional on Vercel: falls back to NEXT_PUBLIC_VERCEL_URL when unset.
# NEXT_PUBLIC_BASE_URL=https://YOUR-STOREFRONT-DOMAIN

# Stripe publishable key. Only needed if the Stripe payment provider is
# enabled in Medusa. Leave unset to skip Stripe checkout.
# NEXT_PUBLIC_STRIPE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# Medusa Cloud file storage (only when serving product images from S3).
# Both must be set together to register the remote image pattern.
# MEDUSA_CLOUD_S3_HOSTNAME=your-bucket.s3.ap-south-1.amazonaws.com
# MEDUSA_CLOUD_S3_PATHNAME=/**
