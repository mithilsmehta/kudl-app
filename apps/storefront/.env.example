# ---------------------------------------------------------------------------
# KUDL Pets storefront — environment variables
#
# Copy to `.env.local` for local development. Everything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle and is therefore PUBLIC.
# Never put DATABASE_URL, JWT_SECRET, COOKIE_SECRET or any Medusa admin
# credential in this file.
# ---------------------------------------------------------------------------

# Public base URL of the Medusa Store API. Required, no trailing slash.
#   local:      http://localhost:9000
#   production: https://YOUR-MEDUSA-BACKEND-DOMAIN
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa publishable API key (Medusa Admin -> Settings -> Publishable API Keys).
# Safe for the browser, but environment-specific: use the key belonging to the
# backend NEXT_PUBLIC_MEDUSA_BACKEND_URL points at.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_YOUR_PUBLISHABLE_KEY

# Canonical site URL, used for metadataBase (Open Graph / canonical links).
# NEXT_PUBLIC_BASE_URL=https://YOUR-STOREFRONT-DOMAIN

# Extra image host, when product images are served from S3/CDN rather than the
# Medusa backend itself. Hostname only, no scheme.
# MEDUSA_IMAGE_HOSTNAME=your-bucket.s3.ap-south-1.amazonaws.com
