# KUDL storefront — configuration for apps/storefront/docker-compose.yml.
#
#   cp .env.template .env
#
# Safe to commit. .env is NOT — it is gitignored, keep it that way.
#
# START THE BACKEND FIRST. This stack attaches to the network the backend stack
# creates; it will not start on its own.
#
# Several values below are SHARED with apps/backend/.env and must match it. They
# are duplicated because Docker Compose reads variables from the .env sitting
# next to each compose file — there is no way to share one file between two
# separate compose projects.


# ---- Backend address (SHARED — must match apps/backend/.env) ----
# The public origin of the backend, as a BROWSER would reach it.
#   local:              http://localhost:9000
#   server, no domain:  http://<server-ip>:9000
#   behind Traefik:     https://api.your-domain
#
# Compiled into the browser bundle at build time, so CHANGING IT NEEDS A REBUILD:
#   docker compose up -d --build
MEDUSA_BACKEND_URL=http://localhost:9000

# ---- Publishable API key (SHARED — must match apps/backend/.env) ----
# Every Store API request must carry this. The backend creates it on first boot
# and prints it:
#   cd ../backend && docker compose logs backend | grep 'Publishable API key'
#
# Also compiled into the browser bundle — rebuild after setting it. Leave blank
# on the very first run; the key does not exist until the backend has migrated
# the database once.
MEDUSA_PUBLISHABLE_KEY=

# ---- Razorpay key id (SHARED — must match apps/backend/.env) ----
# Only the PUBLIC key id belongs here. The secret is server-side and must never
# reach a browser bundle — it stays in apps/backend/.env.
RAZORPAY_KEY_ID=

# ---- Product image hosts ----
# Extra hostnames serving product images, comma separated. next/image refuses any
# host not listed and renders a broken placeholder instead. Needed when a CDN or
# custom domain sits in front of the bucket, e.g.
#   MEDUSA_IMAGE_HOSTNAME=kudl-media.s3.ap-south-1.amazonaws.com,cdn.kudl.in
# Compiled in at build time — rebuild after changing.
MEDUSA_IMAGE_HOSTNAME=

# ---- Addresses ----
STOREFRONT_PORT=8000

# Which host interface the port above is published on.
#   127.0.0.1   (default) loopback only — correct when Traefik is in front.
#   0.0.0.0     published openly. Use on a server with an IP and no domain yet.
BIND_ADDRESS=127.0.0.1

# ---- Traefik routing (only used when the backend runs --profile proxy) ----
# The domain this storefront answers on. www.<domain> is matched automatically.
# Leave blank when not using Traefik.
STOREFRONT_DOMAIN=
