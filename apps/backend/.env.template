# Backend configuration — used by BOTH `docker compose` and the native setup.
#   cp .env.template .env
# then fill in the values below. This file is safe to commit; .env is NOT.

# ---- Database (Docker) ----
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medusa-backend
# Host port for Postgres. Nothing else may be holding it — if you run a native
# Postgres on 5432, stop it first (macOS: brew services stop postgresql@16) or set a
# different port here to run both side by side.
POSTGRES_PORT=5432
# Medusa attempts an SSL handshake by default, which hangs against the plain Postgres
# container. Keep "disable" for the containerised database; use "require" when pointing
# at a managed Postgres (RDS, Neon, Supabase) that mandates TLS.
DATABASE_SSLMODE=disable

# ---- Database (native, non-Docker only) ----
# Ignored when running under Docker: compose points Medusa at the postgres container.
DATABASE_URL=
DB_NAME=medusa-backend

# ---- Medusa ----
MEDUSA_PORT=9000
# Generate real values, do not ship these defaults:
#   openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=
# Admin session cookies. Keep "false" while the dashboard is served over http://
# (localhost or a LAN IP) — browsers silently drop Secure cookies on plain http, which
# makes the dashboard bounce back to the login page after a successful sign-in.
# Set to "true" once it is behind HTTPS.
COOKIE_SECURE=false

# ---- Shared team admin login ----
# Created automatically on first boot. Everyone signs in to the dashboard with this.
#
# IMPORTANT: the password is only applied when the user is FIRST created. Medusa's
# `medusa user` command cannot update an existing user, so editing this value later
# does nothing — the original password keeps working and the new one is rejected with
# "Invalid email or password".
#
# To change the password on an existing environment, delete the user and let the next
# boot recreate it. Against the deployed Postgres (Railway -> Postgres -> Data):
#
#   DELETE FROM provider_identity WHERE entity_id = 'admin@kudl.com';
#   DELETE FROM auth_identity
#     WHERE id NOT IN (SELECT auth_identity_id FROM provider_identity
#                      WHERE auth_identity_id IS NOT NULL);
#   DELETE FROM "user" WHERE email = 'admin@kudl.com';
#
# then redeploy (or run `npx medusa user -e <email> -p <password>` in the console).
MEDUSA_ADMIN_EMAIL=admin@kudl.com
MEDUSA_ADMIN_PASSWORD=change-me

# ---- Browser CORS origins (comma separated) ----
# Only affects browsers. The mobile app is unaffected.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
# /auth/* covers customer AND admin sign-in, so this must list the storefront
# origin too — not just the dashboard's. Without :8000 here, products and carts
# load fine but every browser login fails with "Failed to fetch".
AUTH_CORS=http://localhost:8000,http://localhost:9000

# ---- Redis ----
# Optional locally (docker compose runs no Redis service, and Medusa falls back to
# an in-memory event bus, cache and workflow engine).
#
# REQUIRED in any deployed environment. Without it Medusa logs "a fake redis
# instance will be used" and "Local Event Bus installed. This is not recommended
# for production", and every queued job, subscriber and in-flight workflow is lost
# whenever the container restarts — which a platform does on every deploy.
#
# Leave BLANK for local docker compose. "redis://localhost:6379" resolves to the
# Medusa container itself, where nothing is listening, so the app hangs on boot and
# never becomes healthy. To test Redis locally, run a Redis container on the compose
# network and use its service name as the host.
REDIS_URL=

# ---- File storage (deployed environments) ----
# Medusa's default provider writes uploads to ./static on the container's own
# filesystem. That does NOT survive a redeploy or a container recreate, so product
# images uploaded through the dashboard disappear.
#
# Set these to store files in an S3-compatible bucket (AWS S3, Cloudflare R2)
# instead. All three of S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY must
# be present or the S3 provider stays off and the local provider is used.
#
# Leave unset only when the local ./static path is backed by a mounted disk
# (e.g. a Railway Volume at /app/static) and the service runs a single replica.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Public base URL files are served from, e.g. https://cdn.example.com
S3_FILE_URL=
# Required for Cloudflare R2 and other non-AWS endpoints; omit for AWS S3.
S3_ENDPOINT=
