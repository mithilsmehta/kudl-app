# KUDL backend — configuration for apps/backend/docker-compose.yml.
#
#   cp .env.template .env
#
# Safe to commit. .env is NOT — it is gitignored, keep it that way.
#
# One file, two consumers, which is convenient rather than confusing:
#   - Docker Compose reads it for ${VARIABLE} substitution in docker-compose.yml.
#   - Medusa reads it directly when you run `npm run backend:dev` without Docker.
# Variables one of them ignores are simply unused, never harmful.
#
# The storefront has its OWN .env at apps/storefront/.env. A few values appear in
# both and must match — they are marked SHARED below. Compose reads variables from
# the .env next to each compose file, so there is no way to share one file across
# two separate compose projects.


# ============================================================== DATABASE =======
# Used to build DATABASE_URL for the backend container.
#
# Changing POSTGRES_USER or POSTGRES_DB on an EXISTING install points Medusa at a
# database that does not exist inside the volume; the store then comes up looking
# freshly installed while the real data sits untouched and unreachable. Leave them
# alone unless you are starting clean.
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medusa-backend

# Medusa attempts an SSL handshake by default, which hangs against the plain
# Postgres container until the connection pool times out. Keep "disable" for the
# containerised database; use "require" only for a managed Postgres that mandates TLS.
DATABASE_SSLMODE=disable

# Native (non-Docker) runs only — `npm run backend:dev`. Ignored under Docker,
# where compose builds DATABASE_URL from the three values above. To point at the
# containerised Postgres, publish its port first (see the commented `ports:` block
# on the postgres service in docker-compose.yml).
DATABASE_URL=


# ================================================================ SECRETS ======
# Generate real values before exposing this to the internet. Do not ship the
# defaults, and do not reuse the same string for both:
#
#   openssl rand -base64 32
JWT_SECRET=
COOKIE_SECRET=


# ========================================================== ADMIN DASHBOARD ====
# Created automatically on first boot; this is how the team signs in at /app.
#
# IMPORTANT: the password is applied only when the user is FIRST created. Medusa's
# `medusa user` command cannot update an existing user, so editing this value later
# does nothing — the original password keeps working and the new one is rejected
# with "Invalid email or password".
#
# To change it on an existing install, delete the user and let the next boot
# recreate it:
#
#   docker compose exec postgres psql -U medusa -d medusa-backend
#     DELETE FROM provider_identity WHERE entity_id = 'admin@kudl.com';
#     DELETE FROM auth_identity
#       WHERE id NOT IN (SELECT auth_identity_id FROM provider_identity
#                        WHERE auth_identity_id IS NOT NULL);
#     DELETE FROM "user" WHERE email = 'admin@kudl.com';
#
#   docker compose restart backend
MEDUSA_ADMIN_EMAIL=admin@kudl.com
MEDUSA_ADMIN_PASSWORD=change-me


# ============================================================== ADDRESSES ======
MEDUSA_PORT=9000

# SHARED — must match apps/storefront/.env.
#
# Public origin of this backend, as a browser or phone would reach it.
#   local:              http://localhost:9000
#   server, no domain:  http://<server-ip>:9000
#   behind Traefik:     https://api.your-domain
#
# Uploaded product images are stored with URLs built from this, so getting it
# wrong leaves broken images behind even after you fix it.
MEDUSA_BACKEND_URL=http://localhost:9000

# Which host interface MEDUSA_PORT is published on.
#   127.0.0.1   (default) loopback only — correct when Traefik is in front, and
#               on a public server it means the API is NOT directly reachable.
#   0.0.0.0     published openly. Use on a server with an IP and no domain yet.
BIND_ADDRESS=127.0.0.1


# ================================================= REVERSE PROXY (TRAEFIK) =====
# Only used with `docker compose --profile proxy up -d`. Without the profile,
# Traefik does not run and none of this matters.
#
# Point the records at the server's IP BEFORE the first proxied start. Let's
# Encrypt verifies over port 80, so issuance fails if DNS is not live — and it
# rate-limits repeated failures, which can lock you out for hours.
#
#   A   kudl.in       -> <server-ip>     (storefront; set in apps/storefront/.env)
#   A   www.kudl.in   -> <server-ip>
#   A   api.kudl.in   -> <server-ip>     (this backend; BACKEND_DOMAIN below)
BACKEND_DOMAIN=
# Where Let's Encrypt sends expiry warnings. Use a real inbox.
ACME_EMAIL=


# ================================================================== CORS =======
# Browser origins allowed to call the API. The mobile app is unaffected — React
# Native is not subject to CORS.
#
# Medusa applies these per route group, so they are NOT interchangeable:
#   STORE_CORS -> /store/*   products, carts, orders
#   ADMIN_CORS -> /admin/*   the dashboard
#   AUTH_CORS  -> /auth/*    customer AND admin sign-in
#
# AUTH_CORS must list the storefront origin as well as the dashboard's. Leave the
# storefront out and products and carts load fine while every browser sign-in
# fails with "Failed to fetch" — the response comes back without an
# Access-Control-Allow-Origin header and the browser discards it.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# Admin session cookies are marked Secure when NODE_ENV=production, and browsers
# refuse to store a Secure cookie sent over plain http:// — so the dashboard signs
# in successfully and then bounces straight back to the login page.
#
# Keep "false" while serving over http://. Set "true" once behind HTTPS.
COOKIE_SECURE=false


# ================================================================== REDIS ======
# Native (non-Docker) runs only. Under Docker, compose points the backend at the
# redis service. Left blank locally, Medusa uses an in-memory event bus, cache and
# workflow engine, which is fine for development — queued jobs are lost on restart.
REDIS_URL=


# ====================================================== PUBLISHABLE API KEY ====
# SHARED — must match apps/storefront/.env.
#
# Not read by the backend itself; it is created automatically on first boot and
# printed in the log:
#
#   docker compose logs backend | grep 'Publishable API key'
#
# Kept here so both .env files carry the same value. Put it in
# apps/storefront/.env (and rebuild the storefront), and in apps/mobile/.env as
# EXPO_PUBLIC_MEDUSA_PUBLISHABLE_KEY.
MEDUSA_PUBLISHABLE_KEY=


# =========================================================== FILE STORAGE ======
# Leave ALL of these blank to store uploads on the `medusa-static` Docker volume.
# That is a legitimate setup for a single-replica store and survives restarts and
# rebuilds — but not `docker compose down -v`, and not more than one replica.
#
# To use an S3-compatible bucket instead (AWS S3, Cloudflare R2), ALL FOUR of
# S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and S3_FILE_URL must be set,
# or the provider stays off and the volume is used. S3_FILE_URL is in that list
# because the provider builds every image URL as `${S3_FILE_URL}/${key}` —
# without it, uploads succeed and store URLs beginning "undefined/", which renders
# as a broken image and looks exactly like a storage misconfiguration.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Public base URL files are served from, no trailing slash. AWS:
# https://<bucket>.s3.<region>.amazonaws.com — R2: the r2.dev URL or your domain.
S3_FILE_URL=
# Required for Cloudflare R2 and other non-AWS endpoints; omit for AWS S3.
S3_ENDPOINT=
# Leave EMPTY for AWS buckets created since April 2023 (Object Ownership = bucket
# owner enforced, which rejects uploads carrying an ACL) and for R2 (no ACL
# support). Make objects readable with a bucket policy or R2 public access instead.
S3_ACL=


# ================================================================ PAYMENTS =====
# Razorpay Dashboard -> Settings -> API Keys -> Generate Key.
#
# There is no test/live flag: the key pair itself decides which account the money
# moves in. Both values must be present or the provider is not registered at all
# and checkout falls back to Medusa's default provider.
#
# RAZORPAY_KEY_ID is SHARED — must match apps/storefront/.env.
# RAZORPAY_KEY_SECRET is server-side only. Never put it in the storefront .env or
# any mobile bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard -> Settings -> Webhooks. Point it at
#   https://YOUR-BACKEND-DOMAIN/hooks/payment/razorpay_razorpay
# and subscribe to payment.captured, payment.authorized and payment.failed.
#
# Without it, a customer who pays and then closes the tab before the callback runs
# has their money taken while the order is never completed.
RAZORPAY_WEBHOOK_SECRET=


# ============================================================ EMAIL (BREVO) ====
# Transactional email, used for the signup verification code.
#
# LEAVE BLANK AND NOTHING BREAKS: with no API key the backend prints the code to
# its own log instead of emailing it, and the signup screens say so on-screen.
# That is how the flow is developed and tested without an account.
#
# To send real email — free, 300 emails/day:
#   1. Create an account at https://www.brevo.com  (no card required)
#   2. Senders, Domains & Dedicated IPs -> Senders -> Add a sender.
#      Use an address you can receive mail at; Brevo emails it a confirm link.
#      An UNVERIFIED sender is the most common cause of a 400 from the API.
#   3. SMTP & API -> API Keys -> Generate a new API key (v3).
#   4. Paste both below and restart the backend.
BREVO_API_KEY=
# Must be exactly the address verified in step 2.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KUDL Pet Store


# ================================================================ FEATURES =====
# One-time codes for changing the account email. Turn this on ONLY in the same
# change that wires up code delivery — with nothing sending codes, "true" locks
# every customer out of changing their email. The flow currently applies the
# change on the strength of the session and says so plainly in the UI.
# See src/lib/customer-email-change.ts.
EMAIL_CHANGE_OTP_ENABLED=false
