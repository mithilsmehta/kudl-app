{
  "name": "my-medusa-store",
  "private": false,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "mobile:dev": "npm --prefix apps/mobile start",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:seed:catalog": "turbo seed:catalog --filter=@dtc/backend",
    "backend:up": "docker compose -f apps/backend/docker-compose.yml up -d --build",
    "backend:up:proxy": "docker compose -f apps/backend/docker-compose.yml --profile proxy up -d --build",
    "backend:down": "docker compose -f apps/backend/docker-compose.yml down",
    "backend:logs": "docker compose -f apps/backend/docker-compose.yml logs -f backend",
    "backend:key": "docker compose -f apps/backend/docker-compose.yml logs backend | grep 'Publishable API key' | tail -1",
    "storefront:up": "docker compose -f apps/storefront/docker-compose.yml up -d --build",
    "storefront:down": "docker compose -f apps/storefront/docker-compose.yml down",
    "storefront:logs": "docker compose -f apps/storefront/docker-compose.yml logs -f",
    "stack:up": "docker compose -f apps/backend/docker-compose.yml up -d --build && docker compose -f apps/storefront/docker-compose.yml up -d --build",
    "stack:up:proxy": "docker compose -f apps/backend/docker-compose.yml --profile proxy up -d --build && docker compose -f apps/storefront/docker-compose.yml up -d --build",
    "stack:down": "docker compose -f apps/storefront/docker-compose.yml down; docker compose -f apps/backend/docker-compose.yml down",
    "stack:ps": "docker compose -f apps/backend/docker-compose.yml ps && docker compose -f apps/storefront/docker-compose.yml ps"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.1",
      "@types/react-dom": "18.3.1"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**",
    "!apps/mobile/**"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
