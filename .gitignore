# Dependencies
node_modules
.pnp
.pnp.js

# Yarn 2+
.yarn/*
.yarn
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Testing
coverage

# Next.js
**/.next/
**/out/

# Production
**/build
**/dist

# Misc
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — never commit real secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# TypeScript incremental build info
**/*.tsbuildinfo

# Stray lockfile backups
**/package-lock.json.bak
**/pnpm-lock.yaml.bak
**/yarn.lock.bak

# Turbo
.turbo
.vscode

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
**/.DS_Store

# Medusa's local file provider writes uploads here (see the fileModules block in
# apps/backend/medusa-config.ts). Local dev artefacts, never source.
apps/backend/static/

# Database exports. A dump holds every customer's name, email, phone number and
# delivery address — it must never be committed. Ignored as a directory AND by
# extension, so a dump written somewhere else by mistake is still caught.
backups/
*.sql
*.dump
